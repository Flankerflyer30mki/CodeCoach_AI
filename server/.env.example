MONGO_URI=mongodb://localhost:27017/codecoach
PORT=5000

# Optional: at least one enables AI wording; with none, reports use template text
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash

# Browser origins allowed to call the API, comma-separated, exact match
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Reverse proxies in front of the app. Railway: 1. Local: 0.
TRUST_PROXY=0

# Optional tuning (defaults shown)
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=600000
# MAX_CONCURRENT_ANALYSES=5
# MAX_CONCURRENT_PER_CLIENT=2
